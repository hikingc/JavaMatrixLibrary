<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.hikingc</groupId>
    <artifactId>java-matrix-sdk</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>This library permits communication with Matrix compliant servers.</description>
    <url>https://github.com/hikingc/JavaMatrixLibrary</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>J. C.</name>
            <email>73438877+1hiking@users.noreply.github.com</email>
            <organizationUrl>https://github.com/hikingc</organizationUrl>
        </developer>
    </developers>
    <modules>
        <module>matrix-sdk-benchmarks</module>
        <module>matrix-sdk-core</module>
        <module>matrix-sdk-examples</module>
    </modules>

    <scm>
        <connection>scm:git:git://github.com/hikingc/JavaMatrixClient.git</connection>
        <developerConnection>scm:git:ssh://github.com/hikingc/JavaMatrixClient.git</developerConnection>
        <url>https://github.com/hikingc/JavaMatrixClient/tree/main</url>
    </scm>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>3.2.2</version>
                <scope>compile</scope>
            </dependency>


            <dependency>
                <groupId>io.fusionauth</groupId>
                <artifactId>java-http</artifactId>
                <version>1.4.0</version>
            </dependency>

            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>1.0.0</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.18</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>6.1.2</version>
                <scope>test</scope>
            </dependency>

            <!-- Testing deps -->

            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock</artifactId>
                <version>3.13.2</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>3.27.7</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.instancio</groupId>
                <artifactId>instancio-junit</artifactId>
                <version>6.0.0-RC4</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>2.0.18</version>
            </dependency>

            <!-- publishing -->
            <dependency>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.11.0</version>
            </dependency>

        </dependencies>
    </dependencyManagement>


</project>